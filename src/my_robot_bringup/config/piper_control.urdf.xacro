<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">
  <xacro:arg name="headless" default="false"/>
  <xacro:arg name="sim_speed_factor" default="1.0"/>
  <xacro:arg name="model_path" default="$(find my_robot_description)/mjcf/control.xml"/>
  <xacro:include filename="$(find my_robot_description)/urdf/piper_description.urdf"/>

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(arg model_path)</param>
      <param name="headless">$(arg headless)</param>
      <param name="sim_speed_factor">$(arg sim_speed_factor)</param>
    </hardware>
    <xacro:macro name="controlled_joint" params="joint_name">
      <joint name="${joint_name}">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:controlled_joint joint_name="joint1"/>
    <xacro:controlled_joint joint_name="joint2"/>
    <xacro:controlled_joint joint_name="joint3"/>
    <xacro:controlled_joint joint_name="joint4"/>
    <xacro:controlled_joint joint_name="joint5"/>
    <xacro:controlled_joint joint_name="joint6"/>
    <xacro:controlled_joint joint_name="joint7"/>
    <xacro:controlled_joint joint_name="joint8"/>
  </ros2_control>
</robot>
