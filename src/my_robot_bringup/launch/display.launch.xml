<?xml version="1.0"?>

<launch>

    <arg 
        name="robot_model"
        default="$(find-pkg-share my_robot_description)/urdf/piper_description.xacro"
        description="机器人模型路径"/>

    <arg 
        name="rviz_model"
        default="$(find-pkg-share my_robot_bringup)/rviz/my_robot_moveit.rviz"
        description="rviz模型路径"/>


    <node 
        pkg="robot_state_publisher"
        exec="robot_state_publisher" >
        <param 
            name="robot_description"
            value="$(command 'xacro $(var robot_model)')" 
            type="str" />  <!--如果是xacro文件就用'xacro $(var robot_model)'-->

    </node>

    <node
        pkg="controller_manager"
        exec="ros2_control_node"
        args="-r /controller_manager/robot_description:=/robot_description">
        <param from="$(find-pkg-share my_robot_bringup)/config/ros2_controllers.yaml" />
    </node>

    <node
        pkg="controller_manager"
        exec="spawner"
        args="gripper_controller " />

    <node
        pkg="controller_manager"
        exec="spawner"
        args="arm_controller " />

    <node
        pkg="controller_manager"
        exec="spawner"
        args="joint_state_broadcaster " />

    <node
        pkg="my_robot_commander"
        exec="commander"/>
    

    <include file="$(find-pkg-share my_robot_moveit_pkg)/launch/move_group.launch.py" />

    <node 
        pkg="rviz2"
        exec="rviz2"
        output="screen"
        args="-d $(var rviz_model)"/>


</launch>