<?xml version="1.0"?>

<launch>

    <!-- 此独立模型预览与其他工作区隔离；需要联调时可传入相同的域编号。 -->
    <arg name="ros_domain_id" default="96" description="模型预览使用的 ROS 域编号"/>
    <set_env name="ROS_DOMAIN_ID" value="$(var ros_domain_id)"/>

    <arg 
        name="robot_model" 
        default="$(find-pkg-share demo_robot_pkg)/urdf/piper_description.urdf" 
        description="机器人模型路径"/>


    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param 
            name="robot_description"
            value="$(command 'cat $(var robot_model)')" 
            type="str"/>  <!--如果是xacro文件就用'xacro $(var robot_model)'-->
    </node>

    <node 
        pkg="joint_state_publisher_gui" 
        exec="joint_state_publisher_gui"/>


    <node 
        pkg="rviz2"
        exec="rviz2"
        output="screen"
        args="-d $(find-pkg-share demo_robot_pkg)/rviz/robot_preview.rviz"/>


</launch>
