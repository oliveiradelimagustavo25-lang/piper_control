<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <xacro:macro name="gazebo_sensor_plugin">
    <gazebo reference="camera_link">
    <sensor type="depth" name="camera_sensor">
        <plugin name="depth_camera" filename="libgazebo_ros_camera.so">
            <frame_name>camera_optical_link</frame_name>  <!--设定从camera_optical_link为frame_id输出数据-->
        </plugin>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera name="camera">
            <horizontal_fov>1.5009831567</horizontal_fov>
            <image> <!--图像数据-->
                <width>800</width>
                <height>600</height>
                <format>R8G8B8</format>
            </image>
            <distortion>  
                <k1>0.0</k1> <!--畸变参数-->
                <k2>0.0</k2>
                <k3>0.0</k3>
                <p1>0.0</p1>
                <p2>0.0</p2>
                <center>0.5 0.5</center> <!--图片中心点-->
            </distortion>
        </camera>
    </sensor>
    </gazebo>
        </xacro:macro>
</robot>