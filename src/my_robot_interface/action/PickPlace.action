# Goal：完成一个物块的抓取和放置。
# object_id 对应规划场景中的物体名称，不使用颜色作为唯一编号。
string object_id
uint16 class_id  # 类别表编号；0 为手动目标，使用传入尺寸的包围盒

# 物体几何中心位姿；header 包含观测时间和坐标系，方向为有效单位四元数。
# object_points 是表面点；新 objects 话题已输出中心位姿，不需重复换算。
geometry_msgs/PoseStamped object_pose

# 物体自身坐标系下的包围尺寸 x/y/z，单位 m，均须大于零。
geometry_msgs/Vector3 object_dimensions

# 放置后的物体几何中心位姿，不是夹爪 TCP 位姿。
# 固定放置坐标可用零时间戳，坐标系仍需明确指定。
geometry_msgs/PoseStamped place_pose

# 可选：抓取网络候选列表，数据驱动降级的唯一开关。
# 空数组 = 本次没有候选，执行器走传统深度链路（固定向下）。
# 顺序即优先级（模型 score 降序）：执行器按序尝试，取第一个同时通过
# 开口粗筛、倾角/偏心准入、且放置预位姿 IK 可解的候选；全部不合格才回退传统。
# 每条候选的 tcp_pose 为夹持中心位姿（base_link），姿态即抓取坐标系：
#   +z = 接近轴（手腕指向指尖），+x = 开合轴，+y 由右手系确定；
#   header.stamp 为候选对应观测帧的时间，width 为候选开口（不等于真实物体宽度）。
my_robot_interface/GraspCandidate[] grasp_candidates
---
# Result：执行结果；最终是否进入颜色分拣区域由任务节点另行视觉验证。
bool success
string message
bool holding                       # 执行器仍保留负载；不能直接开始下一抓
bool released                      # 已在目标位置执行释放，不代表物理放置已核验
bool unreachable_placement         # 抓取前发现放置位不可用，可换位置，不计物体抓取失败
bool ready_for_next_pick            # 已空载、夹爪张开且碰撞许可恢复

# unreachable_placement 为真时的预检失败阶段；前提错误时也不计抓取失败。
uint8 PRECHECK_NONE=0              # 预检通过或失败与放置预检无关
uint8 PRECHECK_PRE_GRASP_IK=1      # 预放置姿态本次未求出 IK 解
uint8 PRECHECK_PLACE_IK=2          # 放置姿态本次未求出 IK 解
uint8 PRECHECK_RELEASE_SPACE=3     # 求出 IK，但松爪采样发生碰撞或越界
uint8 PRECHECK_PRECONDITION=4      # 观测、尺寸、朝向等前提错误，等待条件恢复
uint8 precheck_failure

# 本次实际采用的抓取来源："traditional"（固定向下）或 "graspnet"（候选姿态）。
# 供评估区分"有候选"与"真的用了候选"。
string grasp_source_used
---
# Feedback：只报告主要阶段，完成或失败通过 Result 返回。
uint8 PREPARING=0     # 检查目标、准备规划场景
uint8 PICKING=1       # 张开、接近、下降、夹紧
uint8 TRANSFERRING=2  # 抬升、搬运
uint8 PLACING=3       # 下降、松开、撤离

uint8 stage
string message
