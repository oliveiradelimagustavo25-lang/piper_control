<?xml version="1.0"?>

<sdf version="1.6">

    <model name="aruco_board">


    <!-- Keep the target fixed so it cannot fall before the camera detects it. -->
    <static>true</static>


    <link name="board">


    <visual name="visual">


        <geometry>

            <box>

                <size>
                0.2 0.01 0.2
                </size>

            </box>

        </geometry>


        <material>

        <script>

            <uri>
                file://aruco_model/materials/scripts/marker.material
            </uri>

            <uri>
                file://aruco_model/materials/textures
            </uri>

            <name>
                marker
            </name>

        </script>

        </material>


    </visual>


    <collision name="collision">

            <geometry>

                <box>

                    <size>
                        0.2 0.01 0.2
                    </size>

                </box>

            </geometry>

    </collision>


    </link>


    </model>

</sdf>
