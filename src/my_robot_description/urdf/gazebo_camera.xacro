<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
    <xacro:macro name="gazebo_sensor_plugin" params="camera_config">
    <xacro:property name="settings" value="${xacro.load_yaml(camera_config)}"/>
    <gazebo reference="camera_link">
    <sensor type="depth" name="camera_sensor">
        <plugin name="depth_camera" filename="libgazebo_ros_camera.so">
            <frame_name>camera_optical_link</frame_name>  <!--设定从camera_optical_link为frame_id输出数据-->
            <!-- 与定位节点一致；插件默认 0.4 m 会过滤腕部相机的近距离物块。 -->
            <min_depth>${settings['min_depth']}</min_depth>
            <max_depth>${settings['max_depth']}</max_depth>
        </plugin>
        <always_on>true</always_on>
        <update_rate>${settings['update_rate']}</update_rate>
        <camera name="camera">
            <horizontal_fov>${settings['horizontal_fov']}</horizontal_fov>
            <clip>
                <near>${settings['near']}</near>
                <far>${settings['far']}</far>
            </clip>
            <image> <!--图像数据-->
                <width>${settings['width']}</width>
                <height>${settings['height']}</height>
                <format>R8G8B8</format>
            </image>
            <distortion>  
                <k1>0.0</k1> <!--畸变参数-->
                <k2>0.0</k2>
                <k3>0.0</k3>
                <p1>0.0</p1>
                <p2>0.0</p2>
                <center>0.5 0.5</center> <!--图片中心点-->
            </distortion>
        </camera>
    </sensor>
    </gazebo>
        </xacro:macro>
</robot>
