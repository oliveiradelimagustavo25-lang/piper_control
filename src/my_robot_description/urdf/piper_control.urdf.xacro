<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="piper">
  <xacro:arg name="controllers_file" default="$(find my_robot_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="camera_config" default="$(find my_robot_world)/config/camera.yaml"/>
  <xacro:include filename="$(find my_robot_description)/urdf/piper_description.urdf"/>
  <xacro:include filename="$(find my_robot_description)/urdf/piper_ros_control.xacro"/>
  <xacro:include filename="$(find my_robot_description)/urdf/gazebo_camera.xacro"/>
  <xacro:piper_ros_control controllers_file="$(arg controllers_file)"/>
  <xacro:gazebo_sensor_plugin camera_config="$(arg camera_config)"/>
</robot>
