<mujoco model="piper_control">
  <!-- Keep the robot geometry shared with the static preview. -->
  <include file="piper.xml"/>
  <!-- Short steps keep the lightweight wrist and position actuators stable. -->
  <option timestep="0.0002"/>
  <!-- The fixed base and first link overlap at their joint in the source mesh. -->
  <contact><exclude body1="base_link" body2="link1"/></contact>
  <actuator>
    <!-- Initial simulation gains; tune them using measured tracking behavior. -->
    <position name="joint1" joint="joint1" kp="300" dampratio="1" ctrlrange="-2.618 2.618"/>
    <position name="joint2" joint="joint2" kp="300" dampratio="1" ctrlrange="0 3.14"/>
    <position name="joint3" joint="joint3" kp="300" dampratio="1" ctrlrange="-2.967 0"/>
    <position name="joint4" joint="joint4" kp="80" dampratio="1" ctrlrange="-1.745 1.745"/>
    <position name="joint5" joint="joint5" kp="80" dampratio="1" ctrlrange="-1.22 1.22"/>
    <position name="joint6" joint="joint6" kp="40" dampratio="1" ctrlrange="-2.0944 2.0944"/>
    <position name="joint7" joint="joint7" kp="500" dampratio="1" ctrlrange="0 0.035"/>
    <position name="joint8" joint="joint8" kp="500" dampratio="1" ctrlrange="-0.035 0"/>
  </actuator>
</mujoco>
